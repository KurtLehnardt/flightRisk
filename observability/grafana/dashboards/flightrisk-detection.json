      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum by (le, signal) (rate(flightrisk_signal_score_bucket{service_instance_id=~\"$node\"}[5m])))", "legendFormat": "p50 {{signal}}", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, signal) (rate(flightrisk_signal_score_bucket{service_instance_id=~\"$node\"}[5m])))", "legendFormat": "p95 {{signal}}", "refId": "B"}],
