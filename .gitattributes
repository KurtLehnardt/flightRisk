# Hashed by tests/test_param_change_control.py: never convert line endings.
# Git does not rewrite an unchanged file when only its attributes change, so a Windows
# checkout made before these lines existed keeps CRLF copies until they are checked out
# again: git checkout -- <the four files below>.
/flightrisk/params/table.py -text
/tests/golden/flight_params.json -text
/tests/param_literal_allowlist.py -text
/docs/design/hardware-profiles/safety-value-changes.md -text
# The snapshot test compares the raw bytes of these files, so a checkout must not convert their line endings.
/tests/fixtures/plan_snapshots/*.json -text
